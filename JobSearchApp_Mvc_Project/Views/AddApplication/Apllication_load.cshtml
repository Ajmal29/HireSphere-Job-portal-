@model JobSearchApp_Mvc_Project.Models.Applicationcls
@{
    ViewBag.Title = "Job Application";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .application-container {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
        border: 1px solid #e2e8f0;
        overflow: hidden;
        margin-bottom: 25px;
    }

    .card-header {
        background: linear-gradient(135deg, #1e3a8a, #3b82f6);
        color: #ffffff;
        padding: 20px 25px;
    }

    .card-header h2 {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
    }

    .card-body {
        padding: 25px;
    }

    .job-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px 25px;
        margin-bottom: 25px;
    }

    .job-info-item label {
        font-size: 13px;
        font-weight: 600;
        color: #64748b;
        display: block;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .job-info-item span {
        font-size: 16px;
        color: #1e293b;
        font-weight: 500;
    }

    .alert-applied {
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        padding: 16px 20px;
        border-radius: 8px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        color: #334155;
        margin-bottom: 8px;
    }

    .file-input {
        width: 100%;
        padding: 12px;
        border: 2px dashed #cbd5e1;
        border-radius: 8px;
        background: #f8fafc;
        box-sizing: border-box;
        cursor: pointer;
    }

    .btn-apply-submit {
        background: #2563eb;
        color: #ffffff;
        border: none;
        padding: 12px 28px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-apply-submit:hover {
        background: #1d4ed8;
    }

    .btn-secondary {
        display: inline-block;
        margin-left: 15px;
        color: #64748b;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
    }

    .btn-secondary:hover {
        color: #1e293b;
        text-decoration: underline;
    }
</style>

<div class="application-container">
    <div class="card">
        <div class="card-header">
            <h2>Job Application Details</h2>
        </div>

        <div class="card-body">
            @if (Model != null && Model.selectjobdetails != null && Model.selectjobdetails.Count > 0)
            {
                var job = Model.selectjobdetails[0];
                <div class="job-info-grid">
                    <div class="job-info-item">
                        <label>Job Title</label>
                        <span><strong>@job.Job_Tittle</strong></span>
                    </div>
                    <div class="job-info-item">
                        <label>Location</label>
                        <span>@job.Job_Location</span>
                    </div>
                    <div class="job-info-item">
                        <label>Experience Required</label>
                        <span>@job.Job_Experience Yrs</span>
                    </div>
                    <div class="job-info-item">
                        <label>Required Skills</label>
                        <span>@job.Job_Skills</span>
                    </div>
                    <div class="job-info-item">
                        <label>Salary</label>
                        <span>@job.Job_Salary</span>
                    </div>
                    <div class="job-info-item">
                        <label>Application Deadline</label>
                        <span>@job.Job_enddate.ToString("MM/dd/yyyy")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(job.jobtype_name))
                    {
                        <div class="job-info-item">
                            <label>Qualification</label>
                            <span>@job.jobtype_name</span>
                        </div>
                    }
                </div>
            }

            <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 25px 0;" />

            @if (ViewBag.CandidateProfile != null)
            {
                var candidate = ViewBag.CandidateProfile as JobSearchApp_Mvc_Project.sp_profile_Result;
                if (candidate != null)
                {
                    string candPhoto = !string.IsNullOrEmpty(candidate.Photo) ? candidate.Photo.Replace("~/Photos/", "") : "default_user.png";
                    <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 10px; padding: 20px; margin-bottom: 25px;">
                        <h3 style="font-size: 17px; font-weight: 700; color: #1e293b; margin-bottom: 15px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
                            &#128100; Applicant Profile Details
                        </h3>
                        <div style="display: flex; gap: 25px; align-items: flex-start; flex-wrap: wrap;">
                            <div style="text-align: center;">
                                <img src="@Url.Content("~/Photos/" + candPhoto)" width="95" height="95" style="border-radius: 50%; object-fit: cover; border: 3px solid #2563eb;" />
                                <div style="font-weight: 700; color: #1e293b; margin-top: 6px;">@candidate.Name</div>
                            </div>
                            <div style="flex: 1; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px 20px;">
                                <div><strong style="color: #64748b; font-size: 13px;">Age:</strong> <div>@(candidate.Age > 0 ? candidate.Age.ToString() : "-")</div></div>
                                <div><strong style="color: #64748b; font-size: 13px;">Email:</strong> <div>@(candidate.Email ?? "-")</div></div>
                                <div><strong style="color: #64748b; font-size: 13px;">Phone:</strong> <div>@(candidate.Phone ?? "-")</div></div>
                                <div><strong style="color: #64748b; font-size: 13px;">Address:</strong> <div>@(candidate.Address ?? "-")</div></div>
                                <div><strong style="color: #64748b; font-size: 13px;">Qualification:</strong> <div>@(candidate.Qualification ?? "-")</div></div>
                                <div><strong style="color: #64748b; font-size: 13px;">Experience:</strong> <div>@(candidate.ExperienceYears.HasValue ? candidate.ExperienceYears.Value + " Years" : "-")</div></div>
                                <div style="grid-column: 1 / -1;"><strong style="color: #64748b; font-size: 13px;">Skills:</strong> <div>@(candidate.Skills ?? "-")</div></div>
                            </div>
                        </div>
                    </div>
                }
            }

            @if (ViewBag.isapplied != null && (int)ViewBag.isapplied == 1)
            {
                <div class="alert-applied">
                    <span style="font-size: 20px;">&#9888;</span>
                    <div>
                        <strong>Already Applied!</strong> You have already submitted an application for this job posting.
                    </div>
                </div>

                <a href="@Url.Action("jobview_pageload", "JobView")" class="btn-secondary" style="margin-left: 0;">
                    &larr; Back to Job Search
                </a>
            }
            else
            {
                using (Html.BeginForm("Application_click", "AddApplication", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    <div class="form-group">
                        <label for="file">Upload Your Resume (PDF, DOCX, TXT):</label>
                        <input type="file" name="file" id="file" class="file-input" required />
                    </div>

                    <div style="margin-top: 25px;">
                        <input type="submit" value="Submit Application" class="btn-apply-submit" />
                        <a href="@Url.Action("jobview_pageload", "JobView")" class="btn-secondary">
                            Cancel &amp; Back to Search
                        </a>
                    </div>
                }
            }
        </div>
    </div>
</div>

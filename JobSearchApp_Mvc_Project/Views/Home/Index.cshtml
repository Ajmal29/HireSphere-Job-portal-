@{
    ViewBag.Title = "Build Your Powerful Career";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Full-Screen Hero Banner matching exact screenshot */
    .hero-banner {
        position: relative;
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: linear-gradient(135deg, rgba(20, 24, 45, 0.88), rgba(49, 46, 129, 0.82)),
                    url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
        color: #ffffff;
        padding: 40px 20px;
    }

    .hero-content {
        max-width: 900px;
        margin: 0 auto;
    }

    .hero-title {
        font-size: 56px;
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 25px;
        color: #ffffff;
        text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .hero-play-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        height: 60px;
        background: rgba(255, 255, 255, 0.2);
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-radius: 50%;
        margin: 15px auto;
        backdrop-filter: blur(5px);
        box-shadow: 0 0 25px rgba(255, 255, 255, 0.25);
        cursor: pointer;
        transition: transform 0.3s, background 0.3s;
    }

    .hero-play-icon:hover {
        transform: scale(1.1);
        background: rgba(255, 255, 255, 0.35);
    }

    .hero-play-icon svg {
        fill: #ffffff;
        width: 24px;
        height: 24px;
        margin-left: 3px;
    }

    .hero-quote {
        font-size: 20px;
        font-weight: 400;
        line-height: 1.6;
        color: #e0e7ff;
        max-width: 780px;
        margin: 25px auto 0 auto;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 36px;
        }
        .hero-quote {
            font-size: 16px;
        }
    }
</style>

<!-- Hero Section: Exactly matching user screenshot -->
<section class="hero-banner">
    <div class="hero-content">
        <h1 class="hero-title">
            FIND YOUR DREAM JOB
            <br />
            
            Discover Opportunities. Build Your Future.
        </h1>

        <div class="hero-play-icon">
            <svg viewBox="0 0 24 24">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
        </div>

        <p class="hero-quote">
            Explore exciting career opportunities, connect with top employers, and find the right job to match your skills and ambitions.
        </p>
    </div>
</section>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - HireSphere</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Poppins', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f7f9fc;
            color: #333;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Top Navigation Bar */
        .navbar-custom {
            background-color: #12151c;
            height: 70px;
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 15px rgba(0,0,0,0.25);
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: 35px;
        }

        .navbar-brand {
            font-size: 24px;
            font-weight: 800;
            color: #ffffff;
            text-decoration: none;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: color 0.3s;
        }

        .navbar-brand:hover {
            color: #4f46e5;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 25px;
            align-items: center;
        }

        .nav-links a {
            color: #a0aec0;
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            transition: color 0.2s;
        }

        .nav-links a:hover {
            color: #ffffff;
        }

        /* Right Nav Links */
        .nav-right {
            display: flex;
            align-items: center;
            gap: 20px;
            list-style: none;
        }

        .nav-right a {
            color: #cbd5e1;
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            transition: color 0.2s;
        }

        .nav-right a:hover {
            color: #ffffff;
        }

        /* Dropdown for Signup */
        .dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-toggle {
            color: #cbd5e1;
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 8px 10px;
        }

        .dropdown-toggle:hover {
            color: #ffffff;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: #1a202c;
            min-width: 210px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.35);
            border-radius: 6px;
            overflow: hidden;
            z-index: 1001;
            border: 1px solid #2d3748;
        }

        .dropdown-content a {
            color: #e2e8f0;
            padding: 12px 18px;
            text-decoration: none;
            display: block;
            font-size: 14px;
            font-weight: 400;
            transition: background-color 0.2s, color 0.2s;
        }

        .dropdown-content a:hover {
            background-color: #2b3548;
            color: #60a5fa;
        }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        .nav-user {
            color: #fbbf24;
            font-size: 14px;
            font-weight: 600;
            background: rgba(251, 191, 36, 0.1);
            padding: 6px 14px;
            border-radius: 20px;
            border: 1px solid rgba(251, 191, 36, 0.3);
        }

        .btn-logout {
            background-color: #ef4444;
            color: #ffffff !important;
            padding: 7px 16px;
            border-radius: 5px;
            font-weight: 600 !important;
            transition: background-color 0.2s;
        }

        .btn-logout:hover {
            background-color: #dc2626 !important;
        }

        .btn-nav-primary {
            background: linear-gradient(135deg, #4f46e5, #6366f1);
            color: #ffffff !important;
            padding: 8px 18px;
            border-radius: 5px;
            font-weight: 600 !important;
            transition: opacity 0.2s;
        }

        .btn-nav-primary:hover {
            opacity: 0.9;
        }

        /* Content Area */
        .main-wrapper {
            flex: 1;
            width: 100%;
        }

        /* Footer */
        footer {
            background-color: #12151c;
            color: #718096;
            text-align: center;
            padding: 25px;
            font-size: 14px;
            border-top: 1px solid #1f2733;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar-custom">
            <!-- Left Side: Brand and Links -->
            <div class="nav-left">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">HireSphere</a>
                <ul class="nav-links">
                    <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                    <li><a href="@Url.Action("About", "Home")">About</a></li>
                    <li><a href="@Url.Action("Contact", "Home")">Contact</a></li>
                </ul>
            </div>

            <!-- Right Side: Signup / Login or Logged In Navigation -->
            <ul class="nav-right">
                @if (Session["utype"] == null)
                {
                    <!-- Guest Links -->
                    <li class="dropdown">
                        <a href="javascript:void(0)" class="dropdown-toggle">
                            Signup &#9662;
                        </a>
                        <div class="dropdown-content">
                            <a href="@Url.Action("Insertcompany_Pageload", "CompanyReg")">&#127970; Company Register</a>
                            <a href="@Url.Action("Insertuser_Pageload", "UserReg")">&#128100; User / Candidate Register</a>
                        </div>
                    </li>
                    <li><a href="@Url.Action("Login_Pageload", "Login")">Login</a></li>
                }
                else if (Session["utype"].ToString().Equals("Employer", StringComparison.OrdinalIgnoreCase))
                {
                    <!-- Company Logged In -->
                    <li><a href="@Url.Action("CompanyHome", "CompanyHome")">Dashboard</a></li>
                    <li><a href="@Url.Action("Insert_Pageload", "JobInsert")" class="btn-nav-primary">+ Post Job</a></li>
                    <li class="nav-user">@(Session["uname"] ?? "Company")</li>
                    <li><a href="@Url.Action("Logout", "Login")" class="btn-logout">Logout</a></li>
                }
                else
                {
                    <!-- User / Candidate Logged In -->
                    <li><a href="@Url.Action("jobview_pageload", "JobView")" class="btn-nav-primary">Find & Apply Jobs</a></li>
                    <li><a href="@Url.Action("Display_Pageload", "DisplayAll")">All Jobs</a></li>
                    <li><a href="@Url.Action("Profile_Load", "UserProfileDB")">My Profile</a></li>
                    <li class="nav-user">@(Session["uname"] ?? "User")</li>
                    <li><a href="@Url.Action("Logout", "Login")" class="btn-logout">Logout</a></li>
                }
            </ul>
        </nav>
    </header>

    <main class="main-wrapper">
        @RenderBody()
    </main>

    <footer>
        <p>&copy; @DateTime.Now.Year HireSphere Career Portal. All rights reserved.</p>
    </footer>
</body>
</html>


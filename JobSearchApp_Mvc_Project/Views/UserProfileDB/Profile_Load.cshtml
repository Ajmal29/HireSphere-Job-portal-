@model JobSearchApp_Mvc_Project.Models.ProfileCls

@{
    ViewBag.Title = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string photoFileName = (Model != null && !string.IsNullOrEmpty(Model.photo)) ? Model.photo.Replace("~/Photos/", "") : "default_user.png";
}

<style>
    .profile-page-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 15px;
        min-height: calc(100vh - 160px);
    }

    .profile-card {
        max-width: 540px;
        width: 100%;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border: 1px solid #e2e8f0;
        overflow: hidden;
        animation: fadeIn 0.3s ease-in-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .profile-card-header {
        background: linear-gradient(135deg, #1e293b, #0f172a);
        color: #ffffff;
        text-align: center;
        padding: 30px 20px 20px 20px;
    }

    .profile-card-header h2 {
        font-size: 24px;
        font-weight: 700;
        margin: 0 0 6px 0;
        color: #ffffff;
    }

    .profile-card-header p {
        font-size: 13.5px;
        color: #94a3b8;
        margin: 0;
    }

    .profile-card-body {
        padding: 30px 35px 35px 35px;
    }

    .avatar-wrapper {
        text-align: center;
        margin-top: -10px;
        margin-bottom: 25px;
    }

    .avatar-img {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #ffffff;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        background-color: #f1f5f9;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-size: 13.5px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 7px;
    }

    .form-control-custom {
        width: 100%;
        padding: 11px 14px;
        font-size: 14px;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        background-color: #ffffff;
        color: #1e293b;
        font-family: inherit;
        transition: border-color 0.2s, box-shadow 0.2s;
        box-sizing: border-box;
    }

    .form-control-custom:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        outline: none;
    }

    .form-control-readonly {
        background-color: #f8fafc !important;
        color: #64748b !important;
        cursor: not-allowed;
        border-color: #e2e8f0 !important;
    }

    .file-input-wrapper {
        background: #f8fafc;
        border: 1.5px dashed #cbd5e1;
        border-radius: 8px;
        padding: 12px;
        text-align: center;
    }

    .file-input-wrapper input[type="file"] {
        font-size: 13px;
        color: #475569;
        cursor: pointer;
    }

    .btn-update {
        width: 100%;
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        color: #ffffff;
        border: none;
        padding: 13px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
    }

    .btn-update:hover {
        background: linear-gradient(135deg, #4338ca, #4f46e5);
        box-shadow: 0 6px 16px rgba(79, 70, 229, 0.35);
        transform: translateY(-1px);
    }

    .alert-success-custom {
        background-color: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #065f46;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
        text-align: center;
        font-size: 14px;
        font-weight: 500;
    }

    .profile-footer-links {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #f1f5f9;
        font-size: 13.5px;
    }

    .link-action {
        color: #4f46e5;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
    }

    .link-action:hover {
        color: #3730a3;
        text-decoration: underline;
    }

    .link-muted {
        color: #64748b;
        text-decoration: none;
        font-weight: 500;
    }

    .link-muted:hover {
        color: #1e293b;
        text-decoration: underline;
    }
</style>

<div class="profile-page-wrapper">
    <div class="profile-card">
        <div class="profile-card-header">
            <h2>My Profile</h2>
            <p>View and manage your account information</p>
        </div>

        <div class="profile-card-body">
            @if (Model != null && !string.IsNullOrEmpty(Model.msg))
            {
                <div class="alert-success-custom">
                    @Model.msg
                </div>
            }

            @using (Html.BeginForm("Profile_Load", "userProfileDB", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <div class="avatar-wrapper">
                    <img src="@Url.Content("~/Photos/" + photoFileName)" 
                         alt="Profile Photo" 
                         class="avatar-img" 
                         onerror="this.src='https://ui-avatars.com/api/?name=@(Server.UrlEncode(Model != null && !string.IsNullOrEmpty(Model.name) ? Model.name : "User"))&background=4f46e5&color=fff&size=110';" />
                </div>

                @Html.HiddenFor(m => m.photo)

                <div class="form-group">
                    <label class="form-label" for="name">Full Name</label>
                    @Html.TextBoxFor(m => m.name, new { @class = "form-control-custom form-control-readonly", @readonly = "readonly" })
                </div>

                <div class="form-group">
                    <label class="form-label" for="email">Email Address</label>
                    @Html.TextBoxFor(m => m.email, new { @class = "form-control-custom form-control-readonly", @readonly = "readonly" })
                </div>

                <div class="form-group">
                    <label class="form-label" for="age">Age</label>
                    @Html.TextBoxFor(m => m.age, new { @class = "form-control-custom", @type = "number", @min = "18", @max = "100" })
                </div>

                <div class="form-group">
                    <label class="form-label" for="address">Address</label>
                    @Html.TextBoxFor(m => m.address, new { @class = "form-control-custom", placeholder = "Enter your current address" })
                </div>

                <div class="form-group">
                    <label class="form-label">Change Profile Photo</label>
                    <div class="file-input-wrapper">
                        <input type="file" name="file" accept="image/*" />
                    </div>
                </div>

                <div style="margin-top: 25px;">
                    <button type="submit" class="btn-update">Update Profile</button>
                </div>

                <div class="profile-footer-links">
                    <a href="@Url.Action("Home", "LoginDB")" class="link-muted">Back to Home</a>
                    <a href="@Url.Action("pwd_Load", "ChangePwdDB")" class="link-action">Change Password</a>
                </div>
            }
        </div>
    </div>
</div>
